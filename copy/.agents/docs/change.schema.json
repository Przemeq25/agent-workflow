{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Change (openspec/changes/[<group>/]<ID>/change.json)",
	"type": "object",
	"required": ["id", "title", "status", "subtasks"],
	"properties": {
		"$schema": { "type": "string" },
		"id": {
			"type": "string",
			"pattern": "^([A-Z][A-Z0-9]+-\\d+)(-[a-z0-9]+)*$|^[a-z0-9]+(-[a-z0-9]+)*$"
		},
		"title": { "type": "string", "minLength": 3 },
		"jira": { "type": "string", "pattern": "^$|^[A-Z][A-Z0-9]+-\\d+$" },
		"group": { "type": "string", "pattern": "^$|^[a-z0-9]+(-[a-z0-9]+)*$" },
		"status": { "enum": ["draft", "approved"] },
		"refs": { "type": "array", "items": { "type": "string" } },
		"dependsOn": { "type": "array", "items": { "type": "string" } },
		"openQuestions": { "type": "array", "items": { "type": "string" } },
		"notes": { "type": "string" },
		"approvedAt": { "type": "string" },
		"approvalHash": { "type": "string" },
		"subtasks": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["id", "title", "risk", "size", "acceptanceCriteria"],
				"properties": {
					"id": { "type": "string", "pattern": "^STEP-\\d{2,}$" },
					"title": { "type": "string" },
					"goal": { "type": "string" },
					"risk": { "enum": ["QUICK", "STANDARD", "COMPLEX"] },
					"size": { "enum": ["S", "M"] },
					"refs": { "type": "array", "items": { "type": "string" } },
					"scope": {
						"type": "object",
						"properties": {
							"in": { "type": "array", "items": { "type": "string" } },
							"out": { "type": "array", "items": { "type": "string" } }
						}
					},
					"acceptanceCriteria": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"required": ["id", "given", "when", "then"],
							"properties": {
								"id": { "type": "string", "pattern": "^AC-\\d+$" },
								"given": { "type": "string", "minLength": 1 },
								"when": { "type": "string", "minLength": 1 },
								"then": { "type": "string", "minLength": 1 }
							}
						}
					},
					"verification": { "type": "array", "items": { "type": "string" } },
					"dependsOn": { "type": "array", "items": { "type": "string" } }
				}
			}
		}
	}
}
