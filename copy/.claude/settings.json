{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"agent": "tech-lead",
	"permissions": {
		"defaultMode": "acceptEdits",
		"allow": [
			"Bash",
			"Read",
			"Edit",
			"Write",
			"MultiEdit",
			"Glob",
			"Grep",
			"WebFetch",
			"WebSearch",
			"Task",
			"Skill",
			"TodoWrite"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.local)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(gh pr merge *)",
			"Bash(sudo *)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/guard.mjs\""
					}
				]
			}
		]
	}
}
