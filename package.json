{
	"name": "@przemeq25/agent-workflow",
	"version": "0.3.0",
	"description": "Tool-independent agent workflow (PRD → PM → Tech Lead → implementer, reviewer, QA → PR) with roles and skills in .agents/ and generated adapters for Claude Code, Codex, OpenCode and Kilo.",
	"type": "module",
	"bin": {
		"agent-workflow": "bin/agent-workflow.mjs",
		"create-agent-workflow": "bin/agent-workflow.mjs"
	},
	"exports": {
		".": "./lib/sync.mjs",
		"./postinstall": "./lib/postinstall.mjs",
		"./loop": "./loop/loop.mjs",
		"./package.json": "./package.json"
	},
	"files": ["bin", "lib", "loop", "managed", "scaffold", "README.md"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "node --test test/*.test.mjs"
	},
	"keywords": ["agents", "claude-code", "codex", "opencode", "agents-md", "skills", "workflow"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Przemeq25/agent-workflow.git"
	},
